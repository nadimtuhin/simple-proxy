{
  "name": "simple-proxy-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for @simple-proxy/* packages",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && changeset publish",
    "test:coverage": "pnpm -r test:coverage"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^20.0.0",
    "typescript-eslint": "^8.0.0",
    "@eslint/js": "^10.0.0",
    "globals": "^16.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.2.0",
    "prettier": "^3.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "vite": "^6.3.5"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ]
}
