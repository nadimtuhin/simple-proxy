{
  "name": "@simple-proxy/core",
  "version": "0.2.0",
  "description": "Framework-agnostic HTTP proxy core (axios-based)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run test/",
    "test:coverage": "vitest run --coverage test/",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "nock": "^13.4.0",
    "rimraf": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "proxy",
    "http",
    "axios",
    "middleware",
    "typescript"
  ]
}
