{
  "name": "@simple-proxy/express",
  "version": "0.3.0",
  "description": "Express adapter for @simple-proxy/core",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@simple-proxy/core": "workspace:*",
    "form-data": "^4.0.0"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/multer": "^1.4.11",
    "@types/supertest": "^2.0.16",
    "express": "^4.18.0",
    "multer": "^1.4.5-lts.1",
    "nock": "^13.4.0",
    "rimraf": "^5.0.5",
    "supertest": "^6.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "express",
    "proxy",
    "middleware",
    "typescript"
  ]
}
