{
  "name": "@simple-proxy/fastify",
  "version": "0.2.0",
  "description": "Fastify adapter for @simple-proxy/core",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@simple-proxy/core": "workspace:*",
    "fastify-plugin": "^4.5.0",
    "form-data": "^4.0.0"
  },
  "peerDependencies": {
    "fastify": "^4.0.0 || ^5.0.0",
    "@fastify/multipart": "^8.0.0 || ^9.0.0"
  },
  "peerDependenciesMeta": {
    "@fastify/multipart": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fastify/multipart": "^8.0.0",
    "@simple-proxy/testkit": "workspace:*",
    "fastify": "^4.0.0",
    "nock": "^13.4.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.0.0",
    "vitest": "^4.1.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "fastify",
    "proxy",
    "plugin",
    "typescript"
  ]
}
