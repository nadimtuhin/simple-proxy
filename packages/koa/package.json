{
  "name": "@simple-proxy/koa",
  "version": "0.2.0",
  "description": "Koa adapter for @simple-proxy/core",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@simple-proxy/core": "workspace:*",
    "form-data": "^4.0.0"
  },
  "peerDependencies": {
    "koa": "^2.14.0 || ^3.0.0"
  },
  "devDependencies": {
    "@simple-proxy/testkit": "workspace:*",
    "@koa/multer": "^3.0.2",
    "@koa/router": "^12.0.0",
    "@types/koa": "^2.15.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa__multer": "^2.0.4",
    "@types/koa__router": "^12.0.4",
    "koa": "^2.14.0",
    "koa-bodyparser": "^4.4.0",
    "nock": "^13.4.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.0.0",
    "vitest": "^4.1.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "koa",
    "proxy",
    "middleware",
    "typescript"
  ]
}
